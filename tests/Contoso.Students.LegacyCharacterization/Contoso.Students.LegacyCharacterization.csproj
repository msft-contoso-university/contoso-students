<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="$(LegacySourceRoot)\src\ContosoUniversity.API\Controllers\StudentsController.cs" Link="Legacy\StudentsController.cs" />
    <Compile Include="$(LegacySourceRoot)\src\ContosoUniversity.API\Data\ContosoUniversityAPIContext.cs" Link="Legacy\ContosoUniversityAPIContext.cs" />
    <Compile Include="$(LegacySourceRoot)\src\ContosoUniversity.API\Models\*.cs" Link="Legacy\Models\%(Filename)%(Extension)" />
    <Compile Include="$(LegacySourceRoot)\src\ContosoUniversity.API\DTO\*.cs" Link="Legacy\DTO\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RequireLegacySource" BeforeTargets="CoreCompile">
    <Error Condition="'$(LegacySourceRoot)' == '' or !Exists('$(LegacySourceRoot)\src\ContosoUniversity.API\Controllers\StudentsController.cs')"
           Text="Supply LegacySourceRoot for the verified, unchanged legacy checkout. See README.md." />
  </Target>
</Project>
